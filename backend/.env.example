# Database Connection Configuration
# For local MongoDB running on default port 27017:
MONGO_URI=mongodb://127.0.0.1:27017/skillpathai

# For MongoDB Atlas or remote instance:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Backend Application Server Port
PORT=5000

# OpenAI API Key (Required for AI Roadmap / Chat features)
OPENAI_API_KEY=your_openai_api_key_here
